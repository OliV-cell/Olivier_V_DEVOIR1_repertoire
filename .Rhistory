scores <- pca_result$x
sexe <- ifelse(grepl("XY", rownames(transpose_data_rna_seq)), "M", "F")
t.test(scores[, 1] ~ sexe)
# Résultat : p = 0.488 (NON significatif : PC1 capture 40.4% de la variance globale liée à d'autres facteurs)
t.test(scores[, 2] ~ sexe)
# Identification des gènes contribuant le plus à la séparation sexuelle (PC2)
loadings_pc2 <- sort(abs(loadings[, "PC2"]), decreasing = TRUE)
cat("\nTop 15 des gènes contribuant le plus à la séparation des sexes (PC2) :\n")
print(head(loadings_pc2, 15))
# 1. Extraction des loadings de PC2
loadings_pc2 <- pca_result$rotation[, "PC2"]
# 2. Top 10 des gènes associés aux FEMELLES (les plus positifs)
top_femelles <- head(sort(loadings_pc2, decreasing = TRUE), 10)
cat("\n--- Top 10 gènes les plus exprimés chez les Femelles (PC2+) ---\n")
print(top_femelles)
# 3. Top 10 des gènes associés aux MÂLES (les plus négatifs)
top_males <- head(sort(loadings_pc2, decreasing = FALSE), 10)
# 3. Top 10 des gènes associés aux MÂLES (les plus négatifs)
top_males <- head(sort(loadings_pc2, decreasing = FALSE), 10)
cat("\n--- Top 10 gènes les plus exprimés chez les Mâles (PC2-) ---\n")
print(top_males)
# 4. Où se situent vos deux gènes cibles ?
cat("\nLoading de REM16 (LOC115699937) :", loadings_pc2[grep("115699937", names(loadings_pc2))], "\n")
cat("Rang de REM16 :", which(names(sort(abs(loadings_pc2), decreasing = TRUE)) == grep("115699937", names(loadings_pc2), value = TRUE)), "sur 20 500 gènes\n")
cat("Loading de FT1 (LOC115696989) :", loadings_pc2[grep("115696989", names(loadings_pc2))], "\n")
cat("Rang de REM16 :", which(names(sort(abs(loadings_pc2), decreasing = TRUE)) == grep("115696989", names(loadings_pc2), value = TRUE)), "sur 20 500 gènes\n")
sex <- ifelse(grepl("XY", rownames(transpose_data_rna_seq)), "M", "F")
diff_sex <- colMeans(transpose_data_rna_seq[sex == "F", ]) - colMeans(transpose_data_rna_seq[sex == "M", ])
# Plus sur-exprimé chez la femelle :
head(sort(diff_sex, decreasing = TRUE), 3)
# Plus sur-exprimé chez le mâle :
head(sort(diff_sex, decreasing = FALSE), 3)
# 1. Matrice d'expression brute (20 500 gènes en lignes x 138 échantillons en colonnes)
mat_expr <- t(transpose_data_rna_seq)
heatmap(
mat_expr,
ColSideColors = col_sex,
scale = "none",
col = colorRampPalette(c("royalblue3", "white", "firebrick3"))(100),
margins = c(6, 12),
main = "Expression des 20 gènes les plus différentiels (Femelles vs Mâles)"
)
heatmap(mat_expr)
heatmap(mat_expr,Colv=NA, Rowv=NA,)
# 1. Matrice d'expression brute (20 500 gènes en lignes x 138 échantillons en colonnes)
mat_expr <- t(transpose_data_rna_seq)
# 2. Matrice centrée (écart / différence de chaque échantillon par rapport à la moyenne du gène)
mat_diff <- mat_expr - rowMeans(mat_expr)
# 3. Matrice standardisée en Z-scores (centrée et réduite par gène, idéale pour heatmap)
mat_zscore <- t(scale(transpose_data_rna_seq))
# 4. Matrice de distance euclidienne entre tous les 138 échantillons (138 x 138)
mat_dist_samples <- as.matrix(dist(transpose_data_rna_seq))
# Configuration esthétique commune
# Ordonner les échantillons par sexe (Femelles XX d'abord, puis Mâles XY)
ordre_samples <- order(grepl("XY", colnames(mat_expr)))
col_sex_ord <- ifelse(grepl("XY", colnames(mat_expr)[ordre_samples]), "darkgreen", "darkmagenta")
col_sex_raw <- ifelse(grepl("XY", colnames(mat_expr)), "darkgreen", "darkmagenta")
# Palettes de couleurs harmonieuses
pal_expr <- colorRampPalette(c("#f7fbff", "#9ecae1", "#084594"))(100) # Palette séquentielle bleue
pal_div  <- colorRampPalette(c("#2166ac", "#f7f7f7", "#b2182b"))(100) # Palette divergente Bleu-Blanc-Rouge
pal_dist <- colorRampPalette(c("#081d58", "#41b6c4", "#ffffd9"))(100) # Proche = foncé, distant = clair
# --- 1. Heatmap : Expression brute (mat_expr) ---
heatmap(
mat_expr[, ordre_samples],
Colv = NA, Rowv = NA,
labRow = NA, cexCol = 0.5,
ColSideColors = col_sex_ord,
col = pal_expr,
main = "Heatmap 1 : Expression brute (20 500 gènes)",
xlab = "Échantillons ordonnés par sexe (Magenta = XX, Vert = XY)",
ylab = "20 500 gènes",
margins = c(5, 5)
)
# --- 2. Heatmap : Différence centrée par gène (mat_diff) ---
heatmap(
mat_diff[, ordre_samples],
Colv = NA, Rowv = NA,
labRow = NA, cexCol = 0.5,
ColSideColors = col_sex_ord,
col = pal_div,
main = "Heatmap 2 : Écart à la moyenne par gène (Centré)",
xlab = "Échantillons ordonnés par sexe (Magenta = XX, Vert = XY)",
ylab = "20 500 gènes",
margins = c(5, 5)
)
# --- 3. Heatmap : Z-scores standardisés (mat_zscore) ---
heatmap(
mat_zscore[, ordre_samples],
Colv = NA, Rowv = NA,
labRow = NA, cexCol = 0.5,
ColSideColors = col_sex_ord,
col = pal_div,
main = "Heatmap 3 : Z-scores standardisés (Centré & Réduit)",
xlab = "Échantillons ordonnés par sexe (Magenta = XX, Vert = XY)",
ylab = "20 500 gènes",
margins = c(5, 5)
)
# --- 4. Heatmap : Matrice de distance entre échantillons (mat_dist_samples) ---
heatmap(
mat_dist_samples,
ColSideColors = col_sex_raw,
RowSideColors = col_sex_raw,
col = pal_dist,
cexCol = 0.5, cexRow = 0.5,
main = "Heatmap 4 : Distances euclidiennes entre les 138 échantillons",
xlab = "Échantillons",
ylab = "Échantillons",
margins = c(5, 5)
)
#Heatmap : Différence centrée par gène (mat_diff) ---
heatmap(
mat_diff[, ordre_samples],
Colv = NA, Rowv = NA,
labRow = NA, cexCol = 0.5,
ColSideColors = col_sex_ord,
col = heat.colors(),
main = "Heatmap 2 : Écart à la moyenne par gène (Centré)",
